# ─────────────────────────────────────────────
# EmpireBot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ─────────────────────────────────────────────

# Conexão com o banco de dados PostgreSQL (obrigatório)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://empirebot:TROQUE_ESTA_SENHA@localhost:5432/empirebot

# Senha do painel de controle web (obrigatório)
# É o que você digita na tela de login (usuário é sempre "admin")
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE_AQUI

# Segredo da sessão HTTP (obrigatório em produção)
# Use qualquer string longa e aleatória — ex: gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA

# Porta do servidor web (opcional, padrão: 5000)
PORT=5000

# Modo de execução (opcional)
# "production" ativa cache do frontend e desativa headers de no-cache
NODE_ENV=production
