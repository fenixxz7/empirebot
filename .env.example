# ─────────────────────────────────────────────
# EmpireBot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha:
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ─────────────────────────────────────────────

# Conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
# Troque SuaSenha pela senha que você definiu no initdb
DATABASE_URL=postgresql://postgres:SuaSenha@localhost:5432/empirebot

# Senha para entrar no painel web (usuário é sempre "admin")
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE_AQUI

# String aleatória para segurança das sessões (pode inventar qualquer coisa longa)
SESSION_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA

# Porta onde o app vai rodar (5000 é o padrão)
PORT=5000

# Apenas para produção em VPS — no PC em desenvolvimento deixe comentado
# NODE_ENV=production
