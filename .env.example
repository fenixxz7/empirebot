# ─────────────────────────────────────────────
# EmpireBot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha:
#   cp .env.example .env
# ─────────────────────────────────────────────

# Senha do Postgres dentro do docker (qualquer string forte)
POSTGRES_PASSWORD=troque_esta_senha

# Senha do painel web (usuário é sempre "admin")
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE_AQUI

# Segredo de sessão HTTP (string aleatória longa)
# Gere com: openssl rand -hex 32
SESSION_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA

# Porta exposta na VPS (padrão 5000)
APP_PORT=5000

# ── Variáveis abaixo SÓ pra rodar fora do Docker ──
# (no Docker o compose já define DATABASE_URL automaticamente)

# DATABASE_URL=postgresql://empirebot:senha@localhost:5432/empirebot
# NODE_ENV=production
# PORT=5000
